# Docker Compose settings (copy to .env). The local, non-Docker setup uses server/.env instead.
# The backend container also reads this file, so any variable from server/.env.example
# (GEMINI_API_KEY, EMAIL_*, TWILIO_*, ...) can be added here.

# Required: JWT signing key, a long random value
JWT_SECRET=change-me-to-a-long-random-string

# Database: choose one
# 1) Local MongoDB container: start with `docker compose --profile db up --build`
MONGO_ROOT_USER=medistock
# Letters, digits and - _ . ~ only: it goes into a connection string unescaped
MONGO_ROOT_PASSWORD=change-me
# 2) Your own MongoDB (e.g. Atlas): set this and start with `docker compose up --build`
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medistock

# Where the browser reaches the app and the API (defaults shown)
# FRONTEND_URL=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:5000/api
